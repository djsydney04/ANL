(* ANL scalar and flat-tuple grammar with erased contracts and local state.
   Complete language grammar is intentionally not claimed here.
   Semantics and static restrictions: docs/architecture/type-system.md.
   Module declarations, public functions and qualified paths: spec/modules.md.
   Contract types, scope and verification: spec/verification.md.
   Mutable locals, assignment, and while: spec/control-flow.md.
   Flat tuple syntax, width, types, and evaluation: spec/flat-products.md.
   Erased loop annotations and invariant verification: spec/loop-verification.md.
   Terminals are quoted. [] means optional; {} means zero or more.
   Whitespace and line comments may occur between tokens.
   The lexer uses maximal munch for operators and identifiers.
   Reserved keywords cannot be identifiers. Input must end after program.
*)

program         = { function } ;
function        = "fn", identifier, "(", [ parameters ], ")",
                  "->", type, { requires_clause }, { ensures_clause }, block ;
requires_clause = "requires", spec_expression, ";" ;
ensures_clause  = "ensures", "(", identifier, ")", spec_expression, ";" ;
parameters      = parameter, { ",", parameter } ;
parameter       = identifier, ":", type ;
type            = scalar_type | tuple_type ;
scalar_type     = "i64" | "bool" | "unit" ;
tuple_type      = "(", scalar_type, ",",
                  [ scalar_type, { ",", scalar_type }, [ "," ] ], ")" ;

block           = "{", { statement }, [ expression ], "}" ;
statement       = let_statement | assignment_statement | while_statement
                | expression, ";" ;
let_statement   = "let", [ "mut" ], identifier, [ ":", type ],
                  "=", expression, ";" ;
assignment_statement = identifier, "=", expression, ";" ;
while_statement = "while", "(", expression, ")", { invariant_clause }, block ;
invariant_clause = "invariant", spec_expression, ";" ;

expression      = disjunction ;
disjunction     = conjunction, { "||", conjunction } ;
conjunction     = equality, { "&&", equality } ;
equality        = comparison, [ ( "==" | "!=" ), comparison ] ;
comparison      = sum, [ ( "<" | "<=" | ">" | ">=" ), sum ] ;
sum             = product, { ( "+" | "-" ), product } ;
product         = unary, { ( "*" | "/" | "%" ), unary } ;
unary           = ( "!" | "-" ), unary | postfix ;
postfix         = primary, [ ".", projection_index ] ;
projection_index = "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7" ;
primary         = integer
                | "true"
                | "false"
                | "(", ")"
                | "(", expression, ")"
                | tuple_expression
                | identifier, [ "(", [ arguments ], ")" ]
                | "if", expression, block, "else", block
                | block ;
tuple_expression = "(", expression, ",",
                   [ expression, { ",", expression }, [ "," ] ], ")" ;
arguments       = expression, { ",", expression } ;

spec_expression = spec_disjunction ;
spec_disjunction = spec_conjunction, { "||", spec_conjunction } ;
spec_conjunction = spec_equality, { "&&", spec_equality } ;
spec_equality   = spec_comparison, [ ( "==" | "!=" ), spec_comparison ] ;
spec_comparison = spec_sum, [ ( "<" | "<=" | ">" | ">=" ), spec_sum ] ;
spec_sum        = spec_product, { ( "+" | "-" ), spec_product } ;
spec_product    = spec_unary, { ( "*" | "/" | "%" ), spec_unary } ;
spec_unary      = ( "!" | "-" ), spec_unary | spec_primary ;
spec_primary    = integer | "true" | "false" | "(", ")"
                | "(", spec_expression, ")" | identifier ;

identifier      = ident_start, { ident_start | digit } ;
ident_start     = "A" .. "Z" | "a" .. "z" | "_" ;
integer         = digit, { digit } ;
digit           = "0" .. "9" ;
whitespace      = " " | "\t" | "\r" | "\n" ;
line_comment    = "//", { ? any Unicode scalar except CR or LF ? } ;

(* Source is valid UTF-8. Identifiers are ASCII in M1. Non-ASCII text is
   accepted in comments only. Unknown characters produce lexical errors.
   Keywords: fn let if else true false i64 bool unit.
   requires and ensures are contextual only after a function result type.
   mut is contextual after let only when followed by an identifier.
   while is contextual at a statement boundary only when its matching
   parenthesized condition is followed by a block or contextual invariant.
   invariant is contextual only between a while condition and its body.
   Existing while calls and identifiers remain valid. A while statement has
   no trailing semicolon; each invariant clause requires one.
   Assignments require a mutable local of the same type as the right operand.
   While conditions have bool type and bodies have unit type.
   Specification integers are unbounded, with at most 4096 decimal digits per
   literal. Contract expressions cannot call functions, use blocks, or use if.
   Each contract clause must have bool type; ordinary execution erases clauses.
   Invariant clauses use the same scalar specification expressions and literal
   limit, resolve names at the loop head, and must have bool type. Ordinary source
   checking does not prove their truth or definedness; execution erases them. Verification
   requires an invariant on every loaded loop and rejects recursive call graphs.
   Repeated sum/product/boolean operators associate left.
   Unary operators associate right. Repeated comparisons at the comparison
   level and repeated equalities at the equality level require parentheses:
   1 < 2 < 3 and 1 == 2 == false are invalid. Mixed precedence follows the
   grammar: 1 < 2 == true is valid and means (1 < 2) == true.
   Tuple values/types require 1..8 scalar fields and permit a trailing comma.
   Unit () and grouping (e) are unchanged; (e,) is a singleton tuple.
   Tuple types require a comma; (i64) and () are not type spellings.
   Projection consumes a whole decimal token and requires one digit 0..7
   below the tuple arity; .01 is invalid. Projection binds before unary operators.
   Function arguments and parameters do not permit trailing commas.
   Block comments, escapes, integer suffixes, radix prefixes, and
   underscore-separated integer literals are unsupported.
   Integer range and the special negative-minimum form are checked before
   constructing a typed literal. Unary minus is not part of the token.
   A final expression has no semicolon; an empty block evaluates to unit.
   Exactly one fn main() -> i64 is required for an executable.
*)
