fn keep(p:(i64,bool,unit,i64,bool,unit,i64,unit))->(i64,bool,unit,i64,bool,unit,i64,unit)
ensures (r) r==p;
{p}
fn main()->i64
ensures (r) r==7;
{let mut p0=(7,true,(),10,false,(),13,());
let mut p1=(8,false,(),11,true,(),14,());
p0=keep(p0);
p1=keep(p1);
while(false)
invariant p0==(7,true,(),10,false,(),13,()) && p1==(8,false,(),11,true,(),14,());
{}
if p0==(7,true,(),10,false,(),13,()) && p1==(8,false,(),11,true,(),14,()) {7} else {0}}
